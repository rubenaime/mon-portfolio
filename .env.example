# Exemple de configuration pour l'hébergement en ligne
# Copier vers .env ou définir comme variables d'environnement sur votre hébergeur.

PORT=4173
HOST=0.0.0.0
SITE_URL=https://votre-domaine.com
TRUST_PROXY=1
SECURE_COOKIES=1

# Identifiants initiaux (uniquement au premier démarrage, si data/admin.json n'existe pas)
ADMIN_USER=ruben
ADMIN_PASSWORD=ChangezCeMotDePasse!2026
